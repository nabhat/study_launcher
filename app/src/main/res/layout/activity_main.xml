<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GateFocus"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/card_bg"
            android:text="↻ Scan"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Dedicated GATE Study Hub and Distraction Blocker"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Tamper Protection and Focus Timer Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/card_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProtectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡️ Focus Shield"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2210B981"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="STANDBY"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Live Countdown / Status Display -->
            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="⏱️ Focus Duration: 45 min"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Select study duration and lock distractions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Duration Selector (visible when session is inactive) -->
            <HorizontalScrollView
                android:id="@+id/scrollDurationPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutDurationChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration15"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="15m"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration25"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="25m (Pomo)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration45"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="45m"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/accent"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration60"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="60m (1h)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration90"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="90m"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuration120"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        android:text="120m (2h)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Control Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKioskToggle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_dark"
                    android:text="Start Focus (45m) 🔒"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/accent_green"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllowedApps"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/primary_dark"
                    android:text="Allowed Apps ⚙"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tab Bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/background"
        app:tabIndicatorColor="@color/accent"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/text_secondary" />

    <!-- Storage Path Info -->
    <TextView
        android:id="@+id/tvStoragePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Storage: /storage/emulated/0/GATE/"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Frame for Content Views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📂"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No study materials found"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Copy downloaded GATE videos/workbooks to GATE/ folder"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Video Lectures RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- PDF Workbooks RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPdfs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
