<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/custom_player_control"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- Left Seek Indicator (Rewind 10s) -->
    <TextView
        android:id="@+id/tvSeekLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="72dp"
        android:background="@drawable/bg_seek_indicator"
        android:drawableStart="@drawable/ic_replay_10"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="-10s"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Right Seek Indicator (Forward 10s) -->
    <TextView
        android:id="@+id/tvSeekRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="72dp"
        android:background="@drawable/bg_seek_indicator"
        android:drawableEnd="@drawable/ic_forward_10"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="+10s"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
