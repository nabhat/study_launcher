<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/custom_player_control"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- Left Seek Indicator (Rewind 10s) -->
    <TextView
        android:id="@+id/tvSeekLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="72dp"
        android:background="@drawable/bg_seek_indicator"
        android:drawableStart="@drawable/ic_replay_10"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="-10s"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Right Seek Indicator (Forward 10s) -->
    <TextView
        android:id="@+id/tvSeekRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="72dp"
        android:background="@drawable/bg_seek_indicator"
        android:drawableEnd="@drawable/ic_forward_10"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="+10s"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Left Gesture Indicator (Brightness - VLC Style) -->
    <LinearLayout
        android:id="@+id/layoutBrightnessIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_seek_indicator"
        android:gravity="center"
        android:minWidth="80dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivBrightnessIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_brightness"
            app:tint="@color/white" />

        <ProgressBar
            android:id="@+id/pbBrightness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tvBrightnessPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Gesture Indicator (Volume - VLC Style) -->
    <LinearLayout
        android:id="@+id/layoutVolumeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_seek_indicator"
        android:gravity="center"
        android:minWidth="80dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivVolumeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/white" />

        <ProgressBar
            android:id="@+id/pbVolume"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="70"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="70%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
