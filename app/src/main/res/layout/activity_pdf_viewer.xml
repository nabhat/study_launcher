<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/pdfTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/primary_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnPdfBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvPdfName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page 1 / 1"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- PDF Zoomable Viewport Stack -->
    <com.gatefocus.launcher.ZoomableFrameLayout
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/pdfBottomBar"
        android:layout_below="@id/pdfTopBar"
        android:background="#1E293B"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Unified Content Container (scales and pans together) -->
        <FrameLayout
            android:id="@+id/pdfContentStack"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Rendered PDF Page with solid white paper background -->
            <ImageView
                android:id="@+id/ivPdfPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/white"
                android:scaleType="fitCenter" />

            <!-- Drawing / Solving Overlay Canvas -->
            <com.gatefocus.launcher.DrawingView
                android:id="@+id/drawingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.gatefocus.launcher.ZoomableFrameLayout>

    <!-- Bottom Toolbar for Page Navigation, Zoom Controls & Math Solving Pen -->
    <LinearLayout
        android:id="@+id/pdfBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/primary_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevPage"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/card_bg"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/text_primary"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            android:text="Prev"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextPage"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/card_bg"
            app:icon="@drawable/ic_arrow_forward"
            app:iconTint="@color/text_primary"
            app:iconSize="18dp"
            app:iconGravity="textEnd"
            android:text="Next"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Zoom Controls -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomOut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/card_bg"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_zoom_out"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomReset"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/card_bg"
            android:text="100%"
            android:textColor="@color/accent"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomIn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/card_bg"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_zoom_in"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Pen Mode Toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPen"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/card_bg"
            android:text="Pen"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_edit"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <!-- Eraser Toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEraser"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/card_bg"
            android:text="Eraser"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <!-- Clear Page Drawing -->
        <Button
            android:id="@+id/btnClearDraw"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/card_bg"
            android:text="Clear"
            android:textColor="@color/red" />
    </LinearLayout>

</RelativeLayout>
